# Public hostname pointing at this server (Caddy obtains a TLS certificate for it).
DOMAIN=wherempsstand.com
# Other names pointing at this server; each redirects permanently to DOMAIN (comma-separated). Not the
# wheretheystand.* domains: they belong to the charity's own site, served by Cloudflare.
REDIRECT_DOMAINS="www.wherempsstand.com"
# The charity's other sites on this server, served by this site's web server: "domain=container" pairs, the container
# being the site's app on the shared "sites" network. Each is served once its certificate is added
# (bash /opt/hansardgpt/deploy/cloudflare.sh site DOMAIN). See "Other sites on this server" in docs/HOSTING.md.
SITES="wherecountriesstand.com=wherecountriesstand wherecouncilsstand.com=wherecouncilsstand wherelandlordsstand.com=wherelandlordsstand"
# Anthropic API key for written answers (ANTHROPIC_API_KEY also works).
# Without it the app shows ranked, cited sources only.
HANSARD_ANTHROPIC_API_KEY=
# Secret for the admin endpoints (/api/admin/usage, /api/admin/sync); generate with: openssl rand -hex 24
HANSARD_ADMIN_TOKEN=
# Optional: the Where They Stand family's check token. With it set, GET /api/check gives counts and ages (what is
# waiting for a decision, the newest backup's age, the last day's figures) to whoever presents it, and to no one
# else; without it the address is not there. Never a question, a name or a word of a report.
HANSARD_CHECK_TOKEN=
# Optional: a different donations page from the one in config/settings.toml (https://wheretheystand.uk/donate).
HANSARD_DONATE_URL=

# Off-site copies of the nightly backup (Backblaze B2): a private bucket and a key limited to it.
# Set these with the command in docs/OPERATIONS.md ("Setting up the off-site copy") rather than by hand.
HANSARD_B2_BUCKET=
HANSARD_B2_KEY_ID=
HANSARD_B2_APPLICATION_KEY=

# Companies House public data API key (free), for members' company roles. Set it with the command in
# docs/OPERATIONS.md ("Day to day") rather than by hand; without it, company roles are not collected.
HANSARD_COMPANIES_HOUSE_KEY=
