{
	# Cloudflare's proxy addresses (kept current by deploy/caddy-local.sh): a request from one of them carries the
	# visitor's own address in CF-Connecting-IP, which is then used for rate limits and visit counts
	import /etc/caddy/local/proxies.caddy
}

{$DOMAIN} {
	# the certificate: Caddy's own from Let's Encrypt, or Cloudflare's origin certificate once behind its proxy
	# (deploy/cloudflare.sh)
	import /etc/caddy/local/site.caddy
	encode zstd gzip
	# nothing this site accepts is more than a few kilobytes: a larger request is turned away before the app reads it
	request_body {
		max_size 1MB
	}
	# built files have a fingerprint in their name, so a browser can keep them for a year without asking again
	@fingerprinted path /assets/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
	# the family kit's files have no fingerprint, so none is kept for ever: the fonts never change between versions
	# of the kit, and are kept for 30 days; its style sheets change when the kit is synced, and are kept for an hour
	@familyfonts path /family/fonts/*
	header @familyfonts Cache-Control "public, max-age=2592000"
	@familycss path /family/*.css
	header @familycss Cache-Control "public, max-age=3600"
	# flush_interval -1 streams answers to the browser as they are written (server-sent events)
	reverse_proxy app:8000 {
		flush_interval -1
		# the visitor's address only (from Cloudflare's header when the request came through it), never one a
		# visitor added themselves
		header_up X-Forwarded-For {client_ip}
	}
	header {
		# Set as the answer is sent, after encode has compressed it. encode leaves alone any answer that already says
		# no-transform, so with these set first (Caddy's default when nothing is removed) no page, style sheet or
		# API answer of this site was compressed (found 19 November 2026). The other sites' block below removes
		# Server, which makes Caddy wait in the same way, and theirs were compressed.
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# This site's policy, unless the site sends one of its own, which it does only while its measurement switch is
		# on ([ads] measurement, or HANSARD_ADS_MEASUREMENT in .env; docs/DECISIONS.md, 50): then it is this policy
		# with the hosts the Google tag needs added, from the family kit's measure-csp.json (src/hansard/api/measure.py).
		# So the site's one switch changes its policy too. The other sites' policies are set below, whatever they send.
		?Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
		# Cloudflare must pass pages on as they are: this stops it adding its own analytics script (Web Analytics
		# can be switched on for a site by default), which the privacy notice says this site does not use
		+Cache-Control "no-transform"
	}
}

# The charity's other sites on this server: each runs in its own containers (in its own folder under /opt) on the shared
# "sites" network, and is passed its visitors here, with the same protections as this site (deploy/caddy-local.sh
# writes one block per site, once its certificate is in place)
(other_site) {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	@fingerprinted path /assets/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy {args[0]}:8000 {
		flush_interval -1
		header_up X-Forwarded-For {client_ip}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
		+Cache-Control "no-transform"
		-Server
	}
}
# The same for a site whose measurement switch is on ([ads] measurement = true; the charity's family/MEASUREMENT.md):
# its policy also allows the hosts the Google tag needs, from the family kit's measure-csp.json, and nothing else.
# deploy/caddy-local.sh uses it for each domain in MEASURED_SITES in deploy/.env.
(other_site_measured) {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	@fingerprinted path /assets/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy {args[0]}:8000 {
		flush_interval -1
		header_up X-Forwarded-For {client_ip}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://www.google.co.uk; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://www.google.co.uk https://ad.doubleclick.net; frame-ancestors 'none'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com; frame-src 'self' https://www.googletagmanager.com"
		+Cache-Control "no-transform"
		-Server
	}
}
import /etc/caddy/local/sites.caddy

# www and the other domain names: one permanent redirect to the main address, made by this server, or by Cloudflare
# once its redirect rules are set up (deploy/cloudflare.sh redirects on)
import /etc/caddy/local/redirects.caddy
