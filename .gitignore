# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local data (fetched or generated, including data/settings.local.toml from `hansard bootstrap --sample`)
/data/
/var/

# Web
web/node_modules/
web/dist/
web/coverage/

# Env / secrets
.env
.env.*
!.env.example

# OS / editors
.DS_Store
.idea/
.vscode/
web/*.tsbuildinfo

# server backups (deploy/docker-compose.yml)
deploy/backups/

# This server's own Caddy settings and certificates (deploy/caddy-local.sh, deploy/cloudflare.sh)
/deploy/local/

# scripts' cache of downloaded answers
/.cache/

# evaluation runs stay on the machine that made them; the saved question readings that `hansard eval retrieval`
# uses by default are kept
/eval/runs/*
!/eval/runs/20261011-plans-reference.json
